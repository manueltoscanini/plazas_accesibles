        <mxCell id="detail-report-attributes" value="&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[ID] _id: ObjectId&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] publicSquareId: ObjectId → PublicSquare&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] userId: ObjectId → User&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;changes: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;addWC: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;addPlayground: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;addRamp: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;addHazard: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;modifyWC: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;modifyPlayground: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;modifyRamp: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;modifyHazard: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;deleteWC: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;deletePlayground: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;deleteRamp: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;deleteHazard: Object&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] autoApprovedBy: [ObjectId → User]&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] autoRejectedBy: [ObjectId → User]&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] approvedBy: ObjectId → User&lt;/div&gt;&lt;div style=&quot;line-height:23px;white-space:nowrap;&quot;&gt;[REF] rejectedBy: ObjectId → User&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;spacing=0;overflow=hidden;" vertex="1" parent="detail-report">
          <mxGeometry x="14" y="54" width="612" height="596" as="geometry" />
        </mxCell>
        <mxCell id="rel-userId" value="crea · &lt;b&gt;userId&lt;/b&gt;&lt;br/&gt;1 ↔ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;endArrow=ERzeroToMany;startSize=16;endSize=16;strokeWidth=1.8;strokeColor=#6f4a8f;fontColor=#172d42;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15833333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.1893939393939394;entryDx=0;entryDy=0;" edge="1" parent="1" source="detail-user" target="detail-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-approvedBy" value="aprueba directamente · &lt;b&gt;approvedBy&lt;/b&gt;&lt;br/&gt;0..1 ↔ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startSize=16;endSize=16;strokeWidth=1.8;strokeColor=#6f4a8f;fontColor=#172d42;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3333333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.3484848484848485;entryDx=0;entryDy=0;" edge="1" parent="1" source="detail-user" target="detail-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-rejectedBy" value="rechaza directamente · &lt;b&gt;rejectedBy&lt;/b&gt;&lt;br/&gt;0..1 ↔ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startSize=16;endSize=16;strokeWidth=1.8;strokeColor=#6f4a8f;fontColor=#172d42;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5083333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.5075757575757576;entryDx=0;entryDy=0;" edge="1" parent="1" source="detail-user" target="detail-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-autoApprovedBy" value="confirma (voto positivo) · &lt;b&gt;autoApprovedBy&lt;/b&gt;&lt;br/&gt;0..* ↔ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToMany;startSize=16;endSize=16;strokeWidth=1.8;strokeColor=#6f4a8f;fontColor=#172d42;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6833333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.6666666666666666;entryDx=0;entryDy=0;" edge="1" parent="1" source="detail-user" target="detail-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-autoRejectedBy" value="refuta (voto negativo) · &lt;b&gt;autoRejectedBy&lt;/b&gt;&lt;br/&gt;0..* ↔ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToMany;startSize=16;endSize=16;strokeWidth=1.8;strokeColor=#6f4a8f;fontColor=#172d42;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8583333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.8257575757575758;entryDx=0;entryDy=0;" edge="1" parent="1" source="detail-user" target="detail-report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="user-context" value="&lt;b&gt;Un usuario, varios roles&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;El mismo User puede ser autor, votar o realizar una revisión directa.&lt;br/&gt;&lt;br/&gt;El documento menciona administradores y usuarios de confianza, pero no declara un atributo de rol ni una entidad adicional para ellos." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f2f6f9;strokeColor=#d7e1e9;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="80" y="525" width="350" height="260" as="geometry" />
        </mxCell>
        <mxCell id="read-cardinalities" value="&lt;b&gt;Cómo leer las cardinalidades&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Los valores se indican de &lt;b&gt;User (izquierda)&lt;/b&gt; a &lt;b&gt;Report (derecha)&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;Ejemplo: &lt;b&gt;approvedBy 0..1 ↔ 0..*&lt;/b&gt; significa que cada reporte tiene cero o un aprobador directo y un usuario puede aprobar cero o muchos reportes." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f2f6f9;strokeColor=#d7e1e9;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="480" height="250" as="geometry" />
        </mxCell>
        <mxCell id="assumptions-detail" value="&lt;b&gt;Supuestos que no son restricciones declaradas&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Se interpreta &lt;b&gt;userId&lt;/b&gt; como un autor por reporte; &lt;b&gt;approvedBy&lt;/b&gt; y &lt;b&gt;rejectedBy&lt;/b&gt; se muestran opcionales mientras no hay revisión.&lt;br/&gt;&lt;br/&gt;Los arreglos de votos permiten varios usuarios por reporte y varios reportes por usuario. El texto no define exclusión entre votos, estados ni validaciones de obligatoriedad." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f2f6f9;strokeColor=#d7e1e9;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="565" y="900" width="510" height="250" as="geometry" />
        </mxCell>
        <mxCell id="objects-detail" value="&lt;b&gt;Objetos de cambios y operaciones&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;changes&lt;/b&gt; y los campos add*, modify* y delete* están tipados como &lt;b&gt;Object&lt;/b&gt;; su estructura interna no está especificada.&lt;br/&gt;&lt;br/&gt;No se agregan referencias directas de Report a WC, Playground, Ramp o Hazard porque el documento no las declara." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f2f6f9;strokeColor=#d7e1e9;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="1100" y="900" width="540" height="250" as="geometry" />
        </mxCell>
        <mxCell id="source" value="Fuente: Documento modelos · carpeta compartida Laboratorio 2 .NET · consulta: 05/11/2026 · elaborado con CLI-Anything draw.io" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#52677b;fontStyle=0;spacing=0;overflow=hidden;" vertex="1" parent="1" link="https://docs.google.com/document/d/15zNIaKjulXEgN9O7NYvCQa2mFl9X1IDOeQhBfVDFpvY/edit">
          <mxGeometry x="60" y="1180" width="1580" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
