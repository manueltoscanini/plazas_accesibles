        <mxCell id="type-guide" value="&lt;b&gt;Tipos y lectura del modelo&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Coordenada&lt;/b&gt; es un valor de latitud y longitud; se usa para ubicar plazas y elementos.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;PropuestaDeCambios&lt;/b&gt; describe actualizaciones de la plaza y altas, modificaciones o bajas de sus elementos. Su estructura está pendiente de especificar.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Imagen&lt;/b&gt; representa el valor de una fotografía.&lt;br/&gt;&lt;br/&gt;Los nombres junto a las multiplicidades indican los roles de los extremos." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f4f7fa;strokeColor=#d5e0e9;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="1740" y="925" width="400" height="455" as="geometry" />
        </mxCell>
        <mxCell id="intro-senderos" value="&lt;b&gt;Descripción de un conjunto&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;DescripciónDeSenderos resume los senderos de una plaza. El documento no describe caminos individuales." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f4f7fa;strokeColor=#d5e0e9;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="470" y="755" width="300" height="210" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Notación de la presentación&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Rectángulo:&lt;/b&gt; concepto con atributos.&lt;br/&gt;&lt;b&gt;«datatype»:&lt;/b&gt; tipo de valor, sin identidad propia.&lt;br/&gt;&lt;b&gt;Rombo vacío en Plaza:&lt;/b&gt; agregación compartida.&lt;br/&gt;&lt;b&gt;1 / 0..1 / 0..*:&lt;/b&gt; exactamente uno / opcional / varios.&lt;br/&gt;&lt;br/&gt;La multiplicidad en un extremo cuenta instancias de ese extremo por cada instancia del extremo opuesto." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f4f7fa;strokeColor=#d5e0e9;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="60" y="1450" width="640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="constraints" value="&lt;b&gt;Restricciones respaldadas por el documento&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;R1.&lt;/b&gt; El correo es único entre usuarios.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;R2.&lt;/b&gt; La aprobación o el rechazo directo lo realiza un usuario de confianza o administrador; son roles de Usuario.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;R3.&lt;/b&gt; Confirmar y refutar son relaciones distintas de la decisión directa. La aprobación automática depende de confirmaciones; no se especifica el umbral." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f4f7fa;strokeColor=#d5e0e9;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="730" y="1450" width="670" height="270" as="geometry" />
        </mxCell>
        <mxCell id="assumptions" value="&lt;b&gt;Decisiones y puntos pendientes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Decisiones:&lt;/b&gt; cada elemento pertenece a una plaza; cada reporte tiene un autor y trata una plaza. Una decisión directa puede estar ausente.&lt;br/&gt;&lt;br/&gt;Los peligros se representan con un solo concepto. La duplicación del documento es una cuestión de almacenamiento.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Pendiente:&lt;/b&gt; exclusión de votos o decisiones, coherencia de indicadores de existencia y estructura de la propuesta. No se presupone borrado en cascada." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f4f7fa;strokeColor=#d5e0e9;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172d42;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1450" width="710" height="270" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Fuentes: Documento modelos · Programación 4: Análisis — Modelado del Dominio (atributos, roles, multiplicidades y agregación; diapositiva 37) · 05/11/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#52677b;spacing=0;overflow=hidden;" vertex="1" parent="1" link="https://docs.google.com/presentation/d/1Acru56Sumv7mjbZv2AY98f3H0_-4BwZI/edit?slide=id.p37#slide=id.p37">
          <mxGeometry x="60" y="1750" width="2080" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
